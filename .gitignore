# Dependencies / build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Compact compiler output is committed, but scratch dirs are not
contract/src/managed/**/*.zkir
contract/src/managed/**/*.prover
contract/src/managed/**/*.verifier

# Go
worker/bin/
*.test
*.out

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Local state
.midnight-state.json
*.local
.gateway-state/

# testkit-js logger artifacts (written when its modules are imported)
gateway/logs/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Docker devnet volumes
.docker/
docker/volumes/
