# DisputeVault environment — copy to .env and fill in.
# NEVER commit a real .env file.

# --- Platform authority -----------------------------------------------------
# Admin secret (Bytes<32>, hex). Proves adjudicator/admin authority in-circuit.
# Must match the secret used at contract deployment.
ADMIN_SECRET=

# Platform evidence-encryption private key (P-256, PKCS#8 PEM or hex scalar).
# Held ONLY by the Go adjudication worker. Never exposed to the frontend.
PLATFORM_ENCRYPTION_PRIVATE_KEY=

# --- Adjudication -----------------------------------------------------------
# Optional: LLM API key for LLMAdjudicator. Leave empty to use DemoAdjudicator.
LLM_API_KEY=
# Optional: LLM provider base URL / model override.
LLM_BASE_URL=
LLM_MODEL=

# --- Services ---------------------------------------------------------------
# TS gateway HTTP endpoint used by the worker and the frontend.
GATEWAY_URL=http://localhost:8787

# --- Gateway (TS Midnight boundary) -----------------------------------------
# HTTP bind for the gateway service itself (gateway/src/config.ts).
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1

# Deployed DisputeVault contract address (64 hex chars, 0x-optional).
DISPUTEVAULT_CONTRACT_ADDRESS=

# BIP32 wallet seed (hex) for the gateway's balancing wallet. Required for
# submits; reads work without it. Never commit a real seed.
WALLET_SEED=

# --- Midnight ---------------------------------------------------------------
# undeployed (local devnet) | preview | preprod
MIDNIGHT_NETWORK=undeployed
# Local devnet endpoints (docker-compose.yml)
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v1/graphql
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
# Optional overrides with sensible defaults (see gateway/src/config.ts):
# MIDNIGHT_NODE_WS_URL, MIDNIGHT_INDEXER_WS_URL, DISPUTEVAULT_ZK_ASSETS_DIR,
# GATEWAY_STATE_DIR
